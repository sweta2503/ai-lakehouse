# Copy to .env (`make setup` does this for you). Single source of truth for config.

# ---- Versions (also documented in versions.md) -------------------------------
ICEBERG_VERSION=1.9.2
SPARK_SCALA_SUFFIX=3.5_2.12

# ---- MinIO / S3 ---------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
WAREHOUSE_BUCKET=warehouse
AWS_REGION=us-east-1
# Endpoint as seen from the HOST (Spark runs on the host, not in Docker)
S3_ENDPOINT=http://localhost:9000
# Iceberg REST catalog as seen from the HOST
CATALOG_URI=http://localhost:8181

# ---- Spark --------------------------------------------------------------------
SPARK_DRIVER_MEMORY=4g
# Number of local cores Spark uses (local[N]). Empty = all cores.
SPARK_CORES=
SPARK_SHUFFLE_PARTITIONS=8

# ---- Data ---------------------------------------------------------------------
# Empty = use all rows. Use 5000 for quick smoke tests.
SAMPLE_ROWS=
SYNTHETIC_ROWS=50000
DATA_DIR=data

# ---- Embeddings ---------------------------------------------------------------
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBED_BATCH_SIZE=64
EMBED_BENCH_ROWS=20000

# ---- IVF index ----------------------------------------------------------------
IVF_K=50
IVF_SEED=42
# Small target file size so demo-scale data yields enough files for pruning to show
TARGET_FILE_SIZE_BYTES=262144

# ---- Bonus: Qdrant ------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# ---- Embedding parallelism ------------------------------------------------------
# Spark runs one Python worker per core, each with its own copy of the model. Letting every worker
# also use many torch threads oversubscribes the CPU, so default to 1 torch thread per worker.
EMBED_TORCH_THREADS=1
# Rows for the "load the model on every row" anti-pattern demo (kept tiny on purpose)
EMBED_ANTIPATTERN_ROWS=100
